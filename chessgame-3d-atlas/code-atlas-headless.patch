+    for (const root of roots) {
       const hit = this.lookup(normalize(root + rel))
       if (hit !== undefined) return [hit]
     }
+    // `import pkg.*;` — a wildcard pulls in the whole package, and a Java
+    // package is a directory, so resolve it the way resolveGo does: every
+    // .java file living in that directory. The capture hands us the scoped
+    // identifier without the `.*`, so a package name is all we have here.
+    const segs = spec.split('.').filter(Boolean)
